# Local development defaults. Copy to .env and adjust if necessary.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/marsu-dashboard
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
RATE_LIMIT_MAX=300
