# Local development defaults. Copy to .env and adjust if necessary.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/marsu-dashboard
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
RATE_LIMIT_MAX=300

# --- Empower AI Chatbot ---
# Provider: glm | openai | gemini | custom (any OpenAI-compatible endpoint)
AI_PROVIDER=OpenAI Compatible
# API key from your provider dashboard (Z.ai / OpenAI / Google AI Studio).
# NEVER commit a real key — copy your local backend/.env value to Render
# instead, and keep this file as a template only.
AI_API_KEY=sk-Eg7N7qEWKV0zzBTQxXdHqEsa4d2eda8PRMevW6cdyVI9bRxo
# Model name (provider-specific). Defaults: glm-4.7 / gpt-4o-mini / gemini-2.0-flash
AI_MODEL=glm-4.7
# Override the provider's default base URL (optional; needed for AI_PROVIDER=custom)
AI_BASE_URL=https://agentrouter.org/v1
# Agent loop caps
AI_MAX_TOOL_HOPS=5
AI_MAX_OUTPUT_TOKENS=1500
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=80000
# Dedicated chat rate limit (per user, per 15 minutes)
CHAT_RATE_LIMIT_MAX=20
